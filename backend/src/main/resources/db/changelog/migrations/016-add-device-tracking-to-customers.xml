<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261007-016" author="tranzfa-core">
        <comment>Add current_device_id and last_device_switch_at columns to customers table for CBN compliance</comment>
        <addColumn tableName="customers">
            <column name="current_device_id" type="VARCHAR(128)"/>
            <column name="last_device_switch_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
