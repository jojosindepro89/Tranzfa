<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-identities-and-profiles" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="identities"/>
            </not>
        </preConditions>

        <comment>Create identities, customers, and staff_users tables</comment>

        <!-- IDENTITIES TABLE (CORE IDENTITY ROOT) -->
        <createTable tableName="identities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="identity_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="identities" indexName="idx_identities_public_id">
            <column name="public_id"/>
        </createIndex>
        <createIndex tableName="identities" indexName="idx_identities_type">
            <column name="identity_type"/>
        </createIndex>

        <!-- CUSTOMERS TABLE (RETAIL BANKING PROFILE) -->
        <createTable tableName="customers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_customers_identity" references="identities(id)"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(100)"/>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="phone" type="VARCHAR(32)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="avatar_url" type="VARCHAR(512)"/>
            <column name="kyc_tier" type="VARCHAR(32)" defaultValue="TIER_1">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="customers" indexName="idx_customers_email">
            <column name="email"/>
        </createIndex>
        <createIndex tableName="customers" indexName="idx_customers_phone">
            <column name="phone"/>
        </createIndex>

        <!-- STAFF_USERS TABLE (INTERNAL CORE TEAM & CONTROL ROOM) -->
        <createTable tableName="staff_users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_staff_users_identity" references="identities(id)"/>
            </column>
            <column name="employee_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="corporate_email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="phone" type="VARCHAR(32)"/>
            <column name="department" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="staff_users" indexName="idx_staff_users_emp_id">
            <column name="employee_id"/>
        </createIndex>
        <createIndex tableName="staff_users" indexName="idx_staff_users_email">
            <column name="corporate_email"/>
        </createIndex>
        <createIndex tableName="staff_users" indexName="idx_staff_users_dept">
            <column name="department"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
