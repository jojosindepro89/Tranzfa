<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-fx-rates-and-swaps" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="fx_rates"/>
            </not>
        </preConditions>

        <comment>Create fx_rates and fx_swaps tables for multi-currency and stablecoin conversions</comment>

        <!-- FX_RATES TABLE -->
        <createTable tableName="fx_rates">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pair" type="VARCHAR(16)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="rate" type="NUMERIC(19, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="spread_percent" type="NUMERIC(8, 4)" defaultValueNumeric="0.5000">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- FX_SWAPS TABLE -->
        <createTable tableName="fx_swaps">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_fx_swaps_transaction" references="transactions(id)"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_fx_swaps_customer" references="customers(id)"/>
            </column>
            <column name="reference" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="from_asset" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="to_asset" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="from_amount" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="to_amount" type="NUMERIC(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="execution_rate" type="NUMERIC(19, 8)">
                <constraints nullable="false"/>
            </column>
            <column name="fee" type="NUMERIC(19, 4)" defaultValueNumeric="0.0000">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="SUCCESSFUL">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="fx_swaps" indexName="idx_fx_swaps_customer_id">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
