<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-external-transaction-mappings" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="external_transaction_mappings"/>
            </not>
        </preConditions>

        <comment>Create external_transaction_mappings table for provider transfer IDs and NIP 30-digit session IDs</comment>

        <createTable tableName="external_transaction_mappings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ext_tx_map_transaction" references="transactions(id)"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="external_reference" type="VARCHAR(128)"/>
            <column name="session_id" type="VARCHAR(64)"/>
            <column name="response_code" type="VARCHAR(16)"/>
            <column name="response_message" type="VARCHAR(512)"/>
            <column name="raw_payload" type="TEXT"/>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="external_transaction_mappings" indexName="idx_ext_tx_map_tx_id">
            <column name="transaction_id"/>
        </createIndex>
        <createIndex tableName="external_transaction_mappings" indexName="idx_ext_tx_map_ext_ref">
            <column name="external_reference"/>
        </createIndex>
        <createIndex tableName="external_transaction_mappings" indexName="idx_ext_tx_map_session_id">
            <column name="session_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
