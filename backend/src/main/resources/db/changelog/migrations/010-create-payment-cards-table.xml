<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-create-payment-cards-table" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payment_cards"/>
            </not>
        </preConditions>

        <comment>Create payment_cards table for virtual and physical debit cards</comment>

        <createTable tableName="payment_cards">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_payment_cards_customer" references="customers(id)"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_payment_cards_account" references="accounts(id)"/>
            </column>
            <column name="masked_pan" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="cardholder_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="card_type" type="VARCHAR(32)" defaultValue="VIRTUAL">
                <constraints nullable="false"/>
            </column>
            <column name="card_brand" type="VARCHAR(32)" defaultValue="VISA">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_month" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="daily_limit" type="BIGINT" defaultValueNumeric="500000000">
                <constraints nullable="false"/>
            </column>
            <column name="is_pushed_to_wallet" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="payment_cards" indexName="idx_payment_cards_customer_id">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
