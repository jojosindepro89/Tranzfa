<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-accounts-table" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="accounts"/>
            </not>
        </preConditions>

        <comment>Create provider-agnostic accounts table linked to retail customer profile</comment>

        <createTable tableName="accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_accounts_customer" references="customers(id)"/>
            </column>
            <column name="account_number" type="VARCHAR(32)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="account_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(8)" defaultValue="NGN">
                <constraints nullable="false"/>
            </column>
            <column name="account_type" type="VARCHAR(32)" defaultValue="SAVINGS">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="available_balance" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ledger_balance" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="daily_limit" type="BIGINT" defaultValueNumeric="5000000">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="accounts" indexName="idx_accounts_customer_id">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="accounts" indexName="idx_accounts_account_number">
            <column name="account_number"/>
        </createIndex>
        <createIndex tableName="accounts" indexName="idx_accounts_currency">
            <column name="currency"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
