<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-authentication-credentials" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_credentials"/>
            </not>
        </preConditions>

        <comment>Create password_credentials, pin_credentials, passkey_credentials, otp_tokens, and sessions tables</comment>

        <!-- PASSWORD_CREDENTIALS TABLE (FACTOR 1) -->
        <createTable tableName="password_credentials">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_password_cred_identity" references="identities(id)"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="failed_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_login_on" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- PIN_CREDENTIALS TABLE (FACTOR 3 TRANSACTION SECURITY PIN) -->
        <createTable tableName="pin_credentials">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_pin_cred_identity" references="identities(id)"/>
            </column>
            <column name="pin" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="failed_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="is_set" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- PASSKEY_CREDENTIALS TABLE (BIOMETRIC WEBAUTHN / FIDO2 / FACE ID) -->
        <createTable tableName="passkey_credentials">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_passkey_cred_identity" references="identities(id)"/>
            </column>
            <column name="credential_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="public_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sign_count" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="device_id" type="VARCHAR(128)"/>
            <column name="device_name" type="VARCHAR(128)"/>
            <column name="last_used_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="passkey_credentials" indexName="idx_passkey_cred_identity">
            <column name="identity_id"/>
        </createIndex>

        <!-- OTP_TOKENS TABLE (FACTOR 2 TOTP / SMS / EMAIL OTP) -->
        <createTable tableName="otp_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_otp_tokens_identity" references="identities(id)"/>
            </column>
            <column name="recipient" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="otp_code" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="VARCHAR(64)" defaultValue="LOGIN_2FA">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="VARCHAR(32)" defaultValue="SMS">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_time" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="is_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="otp_tokens" indexName="idx_otp_recipient_purpose">
            <column name="recipient"/>
            <column name="purpose"/>
        </createIndex>

        <!-- SESSIONS TABLE (DEVICE MANAGEMENT & REMOTE LOGOUT) -->
        <createTable tableName="sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_sessions_identity" references="identities(id)"/>
            </column>
            <column name="refresh_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="device_id" type="VARCHAR(128)"/>
            <column name="device_name" type="VARCHAR(128)"/>
            <column name="ip_address" type="VARCHAR(64)"/>
            <column name="user_agent" type="TEXT"/>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="sessions" indexName="idx_sessions_identity">
            <column name="identity_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
