<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-create-webhook-logs-table" author="techlateef">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="webhook_event_logs"/>
            </not>
        </preConditions>

        <comment>Create webhook_event_logs table for idempotent webhook handling and signature audits</comment>

        <createTable tableName="webhook_event_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="event_id" type="VARCHAR(128)"/>
            <column name="event_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="signature" type="VARCHAR(256)"/>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="is_processed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="retry_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="created_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="webhook_event_logs" indexName="idx_webhook_logs_provider_event">
            <column name="provider"/>
            <column name="event_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
